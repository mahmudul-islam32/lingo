# Copy to .env.local and fill in. Never commit real values.
# Supabase project settings -> API. No hosted project exists yet (ADR-003): for local
# development run `supabase start` and copy the URL and anon key it prints
# (API URL is http://127.0.0.1:54321).

# Public (exposed to the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never prefix with NEXT_PUBLIC_, never import in client code).
# Bypasses RLS; not needed by the app in MVP.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI only (supabase/config.toml, [auth.external.google]); leave empty until
# Google sign-in is configured. Not read by the app.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

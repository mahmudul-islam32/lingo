# Copy to .env.local and fill in. Never commit real values.
#
# Accounts flag (CTO-025, ADR-020 §1): accounts are ENABLED only when both public Supabase
# variables below are set at build time. Leave them empty for a guest-only build: no auth
# UI and zero requests to Supabase (today's production behaviour, PD-087).
#
# Public anon / publishable key only. The service-role key and the database password
# never go in the app, .env.local, chat, issues or CI logs.
#
# Local development: run `supabase start` (needs Docker) and copy the values it prints,
# or run `supabase status`:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321           ("API URL")
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<"anon key" / "Publishable key">
# See docs/architecture/local-supabase.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in button (PLT-011): "true" only when the Google provider is configured
# in the Supabase project (and, locally, in supabase/config.toml [auth.external.google]).
# Any other value or empty = no Google button.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=

# Supabase CLI only (supabase/config.toml, [auth.external.google]); leave empty until
# Google sign-in is configured. Not read by the app.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

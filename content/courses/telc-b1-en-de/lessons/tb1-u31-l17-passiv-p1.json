    {
      "id": "tb1-u31-l17-passiv-p1-ex07",
      "type": "explain",
      "title": "Passiv Vergangenheit",
      "body": "Simple past: wurde + participle. Perfect: ist + participle + worden.\n\n*Deutsch:* Präteritum: wurde + Partizip. Perfekt: ist + Partizip + worden.\n\n## Pattern\n\nSubjekt + **wurde** + … + **Partizip II** · **ist** … **Partizip II + worden**",
      "examples": [
        {
          "learning": "Das Auto wurde gestern repariert.",
          "known": "The car was repaired yesterday."
        },
        {
          "learning": "Die Brücke wurde 1990 gebaut.",
          "known": "The bridge was built in 1990."
        }
      ]
    },
    {
      "id": "tb1-u31-l17-passiv-p1-ex08",
      "type": "word_bank_translate",
      "direction": "to_learning",
      "prompt": "The car was repaired yesterday.",
      "tiles": [
        "Das",
        "gestern",
        "repariert",
        "Auto",
        "wurde",
        "Formular",
        "Müll",
        "Die"
      ],
      "answers": [
        "Das Auto wurde gestern repariert."
      ],
      "explanation": "**Why:** Simple past passive: wurde … repariert.\n\n*Warum:* Präteritum Passiv: wurde … repariert."
    },
    {
      "id": "tb1-u31-l17-passiv-p1-ex09",

    {
      "id": "tb1-u31-l20-reflexiv-p1-ex07",
      "type": "explain",
      "title": "Reflexiv mit Dativ",
      "body": "If there's also an accusative object, the reflexive pronoun becomes dative: mir, dir.\n\n*Deutsch:* Gibt es noch ein Akkusativ-Objekt, wird das Reflexivpronomen Dativ: mir, dir.\n\n## Pattern\n\nSubjekt + **Verb** + **mir/dir/sich** + Akk.-Objekt",
      "examples": [
        {
          "learning": "Ich wasche mir die Hände.",
          "known": "I wash my hands."
        },
        {
          "learning": "Kannst du dir das vorstellen?",
          "known": "Can you imagine that?"
        }
      ]
    },
    {
      "id": "tb1-u31-l20-reflexiv-p1-ex08",
      "type": "word_bank_translate",
      "direction": "to_learning",
      "prompt": "I wash my hands.",
      "tiles": [
        "Interessierst",
        "Er",
        "putzt",
        "die",
        "Ich",
        "Hände",
        "mir",
        "wasche"
      ],
      "answers": [
        "Ich wasche mir die Hände."
      ],
      "explanation": "**Why:** die Hände = accusative → mir (dative).\n\n*Warum:* die Hände = Akkusativ → mir (Dativ)."
    },
